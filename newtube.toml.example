# Copy to newtube.toml (git-ignored). Every key can also be set as NEWTUBE_<KEY> in the environment.
port = 8787
host = "0.0.0.0"              # "127.0.0.1" = this machine only (e.g. behind Tailscale serve / a proxy)
data_dir = "data"             # SQLite DB, caches, auth.json
ip_version = "auto"           # "auto", "4" or "6": which IP family to use towards YouTube (ignored with a proxy)
outbound_proxy = ""           # e.g. "socks5://127.0.0.1:1080": all outbound traffic, incl. yt-dlp
js_runtime = "deno"           # deno | node | bun | quickjs
cache_max_bytes = 3221225472  # thumbnail/avatar cache cap (3 GiB)
min_request_interval = 0.8    # seconds between YouTube requests (plus jitter)
request_jitter = 0.6
background_daily_cap = 2000   # background YouTube requests per day (RSS polling now; backfill later)
backfill_daily_cap = 300      # imported (Takeout) videos whose details are fetched per 24 h; 0 = off
egress_mode = "record"        # "record" (note every outside host), "enforce" (block off-allowlist), "off"
embedding_model = ""          # "" = built-in simple embedder; or a folder name under data/models/ (needs `uv sync --extra ml`)
embedding_device = "auto"     # "auto" (GPU if there is one), "cuda" or "cpu"
backup_dir = ""               # where `newtube backup` writes ("" = data/backups)
backup_keep = 14              # how many copies to keep
